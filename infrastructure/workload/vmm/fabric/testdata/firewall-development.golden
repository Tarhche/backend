*filter
:WORKLOAD-FORWARD - [0:0]
:WORKLOAD-INPUT - [0:0]
:WORKLOAD-OUTPUT - [0:0]
-A WORKLOAD-FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A WORKLOAD-FORWARD -s 10.250.0.0/24 -d 10.250.0.0/24 -j DROP
-A WORKLOAD-FORWARD -s 10.250.0.0/24 -d 10.0.0.0/8 -j DROP
-A WORKLOAD-FORWARD -s 10.250.0.0/24 -d 100.64.0.0/10 -j DROP
-A WORKLOAD-FORWARD -s 10.250.0.0/24 -d 127.0.0.0/8 -j DROP
-A WORKLOAD-FORWARD -s 10.250.0.0/24 -d 169.254.0.0/16 -j DROP
-A WORKLOAD-FORWARD -s 10.250.0.0/24 -d 172.16.0.0/12 -j DROP
-A WORKLOAD-FORWARD -s 10.250.0.0/24 -d 192.168.0.0/16 -j DROP
-A WORKLOAD-FORWARD -s 10.250.0.0/24 -p tcp -m multiport --dports 3333,4444,5555,7777,14433,14444,45560,45700 -j DROP
-A WORKLOAD-FORWARD -s 10.250.0.0/24 -p udp -m multiport --dports 3333,4444,5555,7777,14433,14444,45560,45700 -j DROP
-A WORKLOAD-FORWARD -s 10.250.0.0/24 ! -d 10.250.0.0/16 -j ACCEPT
-A WORKLOAD-FORWARD -s 10.250.1.0/24 -d 10.250.1.0/24 -j ACCEPT
-A WORKLOAD-FORWARD -s 10.250.2.0/24 -d 10.250.2.0/24 -j ACCEPT
-A WORKLOAD-FORWARD -s 10.250.0.0/16 -j DROP
-A WORKLOAD-FORWARD -d 10.250.0.0/16 -j DROP
-A WORKLOAD-INPUT -i wkb+ -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A WORKLOAD-INPUT -i wkb+ -j DROP
-I FORWARD 1 -j WORKLOAD-FORWARD
-I INPUT 1 -j WORKLOAD-INPUT
-I OUTPUT 1 -j WORKLOAD-OUTPUT
COMMIT
*nat
:WORKLOAD-POSTROUTING - [0:0]
-A WORKLOAD-POSTROUTING -s 10.250.0.0/24 ! -d 10.250.0.0/16 -j MASQUERADE
-I POSTROUTING 1 -j WORKLOAD-POSTROUTING
COMMIT
