WEB_URL=http://localhost:3000

# storage
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minio-access-key
S3_SECRET_KEY=minio-secret-key
S3_BUCKET_NAME=blog
S3_USE_SSL=false

# database
MONGO_SCHEME=mongodb
MONGO_USERNAME=test
MONGO_PASSWORD=test
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE_NAME=blog

# mail
MAIL_SMTP_FROM=no-reply@localhost
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_HOST=mailserver
MAIL_SMTP_PORT=1025

# messaging
NATS_URL=nats:4222

# runner
BACKEND_DOCKER_HOST=tcp://docker:2375

# Every ingress the workers open connections to, separated by commas. Nothing
# dials a worker, so these are the only ways a request reaches one; a worker
# keeps a pool at each and is reachable through all of them.
RUNNER_TUNNEL_ADDRESSES=runner-ingress:81

# What a worker proves its name with, inside the connection its key already
# opened. The keys say the peer is one of ours; this says which one it claims
# to be.
RUNNER_TUNNEL_TOKEN=a-shared-secret-for-development

# The runner tunnel. Each side holds a private key and the other's public one;
# nothing signs anything, so a key that is not one of these is dropped while the
# handshake is still going. Make a fresh pair with:
#   go run . generate-private-key --out tunnel.pem --public
