# The public half of the key above. The runner's orchestrators verify the access
# tokens the blog signs, and never sign one themselves.
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIGbMBAGByqGSM49AgEGBSuBBAAjA4GGAAQAsgzTg77VGXB0yxnbSJv0Kh6Qlj2p\nGK+9nuYEeSc5ZDpHJH6SZ2D61AxvZ5kWY59LP7Rt/SbiUKXpr/z9MTBRcrkAYHQU\n0vk5NoBglfKSQ51zBPO7FTmH1uobhjpEUxQo2qNwxi8yXlsAaAS4wBEjo/GSoj6G\nxf0dd1B8JB/nmm1R290=\n-----END PUBLIC KEY-----"
WEB_URL=http://localhost:3000

# Where this service answers, said absolutely. It names this estate as an OAuth
# issuer and names the MCP endpoint as the thing an application asks for a
# session to reach, so an application that has never been here can find both.
SERVICE_URL=http://localhost:8000

# storage
S3_ENDPOINT=rustfs:9000
S3_ACCESS_KEY=s3-access-key
S3_SECRET_KEY=s3-secret-key
S3_BUCKET_NAME=blog
S3_USE_SSL=false

# database
MONGO_SCHEME=mongodb
MONGO_USERNAME=test
MONGO_PASSWORD=test
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE_NAME=blog

# mail
MAIL_SMTP_FROM=no-reply@localhost
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_HOST=mailserver
MAIL_SMTP_PORT=1025

# messaging
NATS_URL=nats:4222

# runner
BACKEND_DOCKER_HOST=tcp://docker:2375

# Where the blog reaches the runner control plane's API, on the compose network.
RUNNER_CONTROLPLANE_URL=http://runner-controlplane:80

# The host an orchestrator's containers publish their ports on. Locally every orchestrator
# shares one docker-in-docker daemon, so that daemon's service name is it.
RUNNER_ORCHESTRATOR_ADVERTISE_HOST=docker

# The domain a container's exposed ports are served on. The ingress matches the
# hostname against this, so it carries no port; RUNNER_PUBLIC_INGRESS_DOMAIN is
# the same name with the published port, which is what the dashboard links to.
# Every *.localhost name resolves to the loopback address, so a container is
# reachable in a browser with no DNS to set up.
RUNNER_INGRESS_DOMAIN=runner.localhost
RUNNER_PUBLIC_INGRESS_DOMAIN=runner.localhost:8030

# Every ingress the orchestrators open connections to, separated by commas. Nothing
# dials an orchestrator, so these are the only ways a request reaches one; an orchestrator
# keeps a pool at each and is reachable through all of them.
RUNNER_TUNNEL_ADDRESSES=runner-ingress:81

# The runner orchestrator<>ingress mTLS tunnel. Each end holds its own certificate and the authority to
# check the other against; neither ever needs the authority's private key.
# The PEM itself is the configuration, so nothing has to be mounted next to a
# service. Make a fresh set with: make certs, then: make certs-env
