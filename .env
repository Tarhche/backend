RUNNER_ORCHESTRATOR_03_TUNNEL_KEY="-----BEGIN EC PRIVATE KEY-----\nMHcCAQEEIHnBkuvQYqUdx+8slP1et4c6NKQu02ZKW1uXPh0lWLTVoAoGCCqGSM49\nAwEHoUQDQgAEId/L8caGFdVbx7woFyi5/XAnDU+F1mZeDM2pwSfzsUGdKptfF7ch\nSvw3P2Am/9dXR4i9LqUuRq2wbifcspBuSQ==\n-----END EC PRIVATE KEY-----"

# The name the ingress's certificate answers for, which an orchestrator checks.
RUNNER_TUNNEL_SERVER_NAME=runner-ingress

# Ports the ingress carries arbitrary TCP into the tunnel on, as
# listen=orchestrator:target. The port a connection arrives on is what names the
# orchestrator, because a raw TCP connection carries nothing that could. Empty
# forwards nothing. 8031 below reaches orchestrator-01's own api as a byte pipe,
# which is the same bytes the /runners/{id}/ route carries as HTTP.
RUNNER_INGRESS_FORWARDS=8031=runner-orchestrator-01:api

# Addresses an orchestrator will connect a stream to beyond the services it offers by
# name, as host:port or host:from-to. Empty allows none, which is the only
# shape an ingress cannot talk an orchestrator out of.
RUNNER_TUNNEL_ALLOWED_TARGETS=

# OpenTelemetry / local Grafana (grafana/otel-lgtm, see compose.yaml "grafana"
# service) - traces, logs and metrics all go here and show up in Grafana at
# http://localhost:3001 (admin/admin).
# To go back to Grafana Cloud: endpoint https://otlp-gateway-prod-eu-west-2.grafana.net/otlp,
# insecure=false, and restore OTEL_EXPORTER_OTLP_HEADERS with your Grafana Cloud API key
# (not stored here - fetch it from Grafana Cloud > Connections > OpenTelemetry).
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
OTEL_RESOURCE_ATTRIBUTES="deployment.environment=development"
OTEL_EXPORTER_OTLP_ENDPOINT=http://grafana:4318
OTEL_EXPORTER_OTLP_PROFILES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Continuous profiling
PROFILING_ENABLED=true
