WEB_URL=http://localhost:3000

# storage
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minio-access-key
S3_SECRET_KEY=minio-secret-key
S3_BUCKET_NAME=blog
S3_USE_SSL=false

# database
MONGO_SCHEME=mongodb
MONGO_USERNAME=test
MONGO_PASSWORD=test
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE_NAME=blog

# mail
MAIL_SMTP_FROM=no-reply@localhost
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_HOST=mailserver
MAIL_SMTP_PORT=1025

# messaging
NATS_URL=nats:4222

# runner
BACKEND_DOCKER_HOST=tcp://docker:2375

# Where the blog reaches the runner manager's API, on the compose network.
RUNNER_MANAGER_URL=http://runner-manager:80

# The host a worker's containers publish their ports on. Locally every worker
# shares one docker-in-docker daemon, so that daemon's service name is it.
RUNNER_WORKER_ADVERTISE_HOST=docker

# Where the manager reaches the ingress, which is how a terminal gets to the
# node holding a container.
RUNNER_INGRESS_URL=http://runner-ingress:80

# The domain a container's exposed ports are served on. The ingress matches the
# hostname against this, so it carries no port; RUNNER_PUBLIC_INGRESS_DOMAIN is
# the same name with the published port, which is what the dashboard links to.
# Every *.localhost name resolves to the loopback address, so a container is
# reachable in a browser with no DNS to set up.
RUNNER_INGRESS_DOMAIN=runner.localhost
RUNNER_PUBLIC_INGRESS_DOMAIN=runner.localhost:8030

# Every ingress the workers open connections to, separated by commas. Nothing
# dials a worker, so these are the only ways a request reaches one; a worker
# keeps a pool at each and is reachable through all of them.
RUNNER_TUNNEL_ADDRESSES=runner-ingress:81

# The runner tunnel. Each end holds its own certificate and the authority to
# check the other against; neither ever needs the authority's private key.
# Make them with: make certs
RUNNER_TUNNEL_CA_CERT=/opt/app/tmp/certs/ca/ca.crt
RUNNER_INGRESS_TUNNEL_CERT=/opt/app/tmp/certs/ingress/tls.crt
RUNNER_INGRESS_TUNNEL_KEY=/opt/app/tmp/certs/ingress/tls.key

# The name the ingress's certificate answers for, which a worker checks.
RUNNER_TUNNEL_SERVER_NAME=runner-ingress

# Ports the ingress carries arbitrary TCP into the tunnel on, as
# listen=worker:target. The port a connection arrives on is what names the
# worker, because a raw TCP connection carries nothing that could. Empty
# forwards nothing. 8031 below reaches worker-01's own api as a byte pipe,
# which is the same bytes the /runners/{id}/ route carries as HTTP.
RUNNER_INGRESS_FORWARDS=8031=runner-worker-01:api

# Addresses a worker will connect a stream to beyond the services it offers by
# name, as host:port or host:from-to. Empty allows none, which is the only
# shape an ingress cannot talk a worker out of.
RUNNER_TUNNEL_ALLOWED_TARGETS=

# OpenTelemetry / local Grafana (grafana/otel-lgtm, see compose.yaml "grafana"
# service) - traces, logs and metrics all go here and show up in Grafana at
# http://localhost:3001 (admin/admin).
# To go back to Grafana Cloud: endpoint https://otlp-gateway-prod-eu-west-2.grafana.net/otlp,
# insecure=false, and restore OTEL_EXPORTER_OTLP_HEADERS with your Grafana Cloud API key
# (not stored here - fetch it from Grafana Cloud > Connections > OpenTelemetry).
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
OTEL_RESOURCE_ATTRIBUTES="deployment.environment=development"
OTEL_EXPORTER_OTLP_ENDPOINT=http://grafana:4318
OTEL_EXPORTER_OTLP_PROFILES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Continuous profiling
PROFILING_ENABLED=true
